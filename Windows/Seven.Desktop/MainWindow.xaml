<Window x:Class="Seven.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="SEVEN" Icon="/Assets/seven.ico" Width="1440" Height="920" MinWidth="820" MinHeight="580"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource CanvasBrush}" Foreground="{StaticResource InkBrush}"
        WindowStartupLocation="Manual" PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded" StateChanged="Window_StateChanged"
        Closing="Window_Closing"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="8" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition x:Name="CaptionRow" Height="42" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border x:Name="CaptionBar" Grid.Row="0" Background="#101114" BorderBrush="#24252A" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
          <Button Style="{StaticResource CaptionButton}" ToolTip="Minimize" Click="Minimize_Click"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Path Width="14" Height="14" Data="M 2,8 L 12,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" />
          </Button>
          <Button Style="{StaticResource CaptionButton}" ToolTip="Maximize or restore" Click="MaximizeRestore_Click"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Grid Width="16" Height="16">
              <Path Data="M 2,2 H 14 V 14 H 2 Z" Stroke="#E7E8EA" StrokeThickness="1.2">
                <Path.Style>
                  <Style TargetType="Path">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="Maximized">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Path.Style>
              </Path>
              <Path Data="M 5,2 H 14 V 11 M 2,5 V 14 H 11 V 5" Stroke="#E7E8EA" StrokeThickness="1.2">
                <Path.Style>
                  <Style TargetType="Path">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="Maximized">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Path.Style>
              </Path>
            </Grid>
          </Button>
          <Button Style="{StaticResource CaptionButton}" Tag="Close" ToolTip="Close" Click="Close_Click"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Path Width="14" Height="14" Data="M 3,3 L 11,11 M 11,3 L 3,11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.25" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Background="{StaticResource CanvasBrush}">
      <wv2:WebView2 x:Name="Browser" />
      <Border x:Name="RuntimeHelp" Visibility="Collapsed" Background="{StaticResource CanvasBrush}">
        <StackPanel Width="460" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Image Width="76" Height="76" Margin="0,0,0,23" HorizontalAlignment="Left" Source="/Assets/seven-logo-red.png" />
          <TextBlock FontSize="29" FontWeight="Bold" Text="One quick setup first." />
          <TextBlock Margin="0,11,0,0" Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Text="SEVEN needs Microsoft's Edge WebView2 Runtime to open. Install it once, then launch SEVEN again." />
          <Button Margin="0,24,0,0" Padding="18,11" HorizontalAlignment="Left" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" Content="Get the WebView2 Runtime  ↗" Click="InstallRuntime_Click" />
          <TextBlock Margin="0,12,0,0" Foreground="#73747B" FontSize="10" Text="The download opens on Microsoft's official website." />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
