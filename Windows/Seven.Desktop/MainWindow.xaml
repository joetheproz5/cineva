<Window x:Class="Seven.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="SEVEN" Icon="/Assets/seven.ico" Width="1440" Height="920" MinWidth="820" MinHeight="580"
        Background="{StaticResource CanvasBrush}" Foreground="{StaticResource InkBrush}"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="58" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#101114" BorderBrush="#24252A" BorderThickness="0,0,0,1">
      <Grid Margin="18,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Image Width="68" Height="25" Stretch="Uniform" Source="/Assets/seven-wordmark-v2.png" />
          <Border Width="1" Height="22" Margin="17,0" Background="#303137" />
          <TextBlock VerticalAlignment="Center" Foreground="#96979E" FontSize="11" Text="MOVIES  ·  SERIES  ·  YOURS" />
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="22,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="BackButton" Style="{StaticResource ToolbarButton}" Content="‹" ToolTip="Go back" Click="Back_Click" />
          <Button x:Name="ForwardButton" Margin="3,0,0,0" Style="{StaticResource ToolbarButton}" Content="›" ToolTip="Go forward" Click="Forward_Click" />
          <Button Margin="5,0,0,0" Style="{StaticResource ToolbarButton}" Content="⟳" ToolTip="Reload SEVEN" Click="Reload_Click" />
        </StackPanel>

        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse Width="6" Height="6" Fill="#72D8A0" />
          <TextBlock x:Name="ConnectionLabel" Margin="8,0,14,0" VerticalAlignment="Center" Foreground="#9B9CA3" FontSize="10" Text="Secure connection" />
          <Button Style="{StaticResource ToolbarButton}" Content="Open in browser ↗" FontSize="10" Click="OpenInBrowser_Click" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Background="{StaticResource CanvasBrush}">
      <wv2:WebView2 x:Name="Browser" />
      <Border x:Name="RuntimeHelp" Visibility="Collapsed" Background="{StaticResource CanvasBrush}">
        <StackPanel Width="460" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Image Width="76" Height="76" Margin="0,0,0,23" HorizontalAlignment="Left" Source="/Assets/seven-logo-red.png" />
          <TextBlock FontSize="29" FontWeight="Bold" Text="One quick setup first." />
          <TextBlock Margin="0,11,0,0" Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Text="SEVEN needs Microsoft's Edge WebView2 Runtime to open. Install it once, then launch SEVEN again." />
          <Button Margin="0,24,0,0" Padding="18,11" HorizontalAlignment="Left" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" Content="Get the WebView2 Runtime  ↗" Click="InstallRuntime_Click" />
          <TextBlock Margin="0,12,0,0" Foreground="#73747B" FontSize="10" Text="The download opens on Microsoft's official website." />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
